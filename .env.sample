# --- NKUST AI Agent Workshop 環境設定範本 ---

# [必要] Google Gemini API Key / openai api key /ollama api key /ollama web search
# 取得網址: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_WEB_SEARCH_API_KEY=your_openai_api_key_here


# [切換模式] Agent 執行模式 (gemini、openai、ollama 或 litellm)
#   litellm = 透過 LiteLLM 接通 100+ 家供應商（Anthropic/Groq/OpenAI/Gemini/Ollama…）
AGENT_MODE=gemini

# [Ollama 連線設定] 預設 http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434


# [自定義模型] 具體使用的模型名稱 (預設: gemini-2.5-flash 或 gemma4)
#   AGENT_MODE=litellm 時，MODEL_NAME 必須是完整 litellm 字串，例如：
#     anthropic/claude-sonnet-4-5、gpt-4o-mini、gemini/gemini-2.0-flash、
#     groq/llama-3.3-70b-versatile、ollama/gemma2
#   金鑰走各家原生環境變數（ANTHROPIC_API_KEY / GROQ_API_KEY / OPENAI_API_KEY…）
MODEL_NAME=gemini-2.5-flash

# [LiteLLM 選用] 覆寫金鑰 / 自訂端點（一般留空，讓各家原生環境變數生效）
# LITELLM_API_KEY=
# LITELLM_BASE_URL=
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# [Discord 整合] 階段二/三使用的 Webhook
# 取得方式: Discord 頻道 -> 編輯頻道 -> 整合 -> 建立 Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- 以下為 Google Calendar ﹑ Google Gmail api參考設定 ---
# 取得方式: Google Cloud Console -> API -> Credentials -> OAuth 2.0
# 請記得專案 Google Calendar &&  Google Gmail api 打開
GOOGLE_CALENDAR_CREDENTIALS=credentials.local.json
GOOGLE_GMAIL_CREDENTIALS=credentials.local.json



# ── Memory Backend ──────────────────────────────────────────────────────────
# 選擇後端: sqlite | inmemory | postgres | redis
#   sqlite   = Python 內建，零安裝、檔案持久化（重啟仍記得），存於 src/data/app.db（預設）
#   inmemory = 重啟後記憶消失
MEMORY_BACKEND=sqlite

# SQLite 檔路徑（記憶 + 會議室登記共用，預設 src/data/app.db）
# SQLITE_DB_PATH=

# ── PostgreSQL (MEMORY_BACKEND=postgres 時需要) ──────────────────────────────
# 可以直接給整條 DSN，或拆開設定
# POSTGRES_DSN=host=localhost port=5432 dbname=adk_memory user=postgres password=secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adk_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# ── Redis (MEMORY_BACKEND=redis 時需要) ──────────────────────────────────────
# 需要 Redis Stack 或安裝 RediSearch module
# Docker 快速啟動: docker run -p 6379:6379 redis/redis-stack-server
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
